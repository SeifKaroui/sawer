{
  "app-id": "io.sawer.app",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "Sawer",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=xdg-documents"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "sawer-release-payload",
      "buildsystem": "simple",
      "build-commands": ["cp -a payload/. /app/"],
      "sources": [{"type": "dir", "path": "payload", "dest": "payload"}]
    }
  ]
}
